# RabbitMQ connection settings
MESSAGE_QUEUE_HOST=rabbitmq
MESSAGE_QUEUE_PORT=5672
MESSAGE_QUEUE_USER=guest
MESSAGE_QUEUE_PASSWORD=guest

# Topology
EXCHANGE_NAME=data_events_exchange
ROUTING_KEY=data.ingest
QUEUE_NAME=data_ingest_queue
DLQ_EXCHANGE_NAME=data_events_dlx
DLQ_QUEUE_NAME=data_ingest_dlq
PREFETCH_COUNT=10

# Retry / backoff configuration
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1

# Database connection settings
DB_HOST=db
DB_PORT=5432
DB_NAME=processed_data
DB_USER=user
DB_PASSWORD=password
